# Alpha deployment env for docker/docker-compose.alpha.yml.
# Copy to docker/alpha/.env (git-ignored), fill every value, chmod 600.
# Never commit the filled file.

# REQUIRED: image digest for the exact reviewed, green release commit.
# Leave unset by default so an operator cannot accidentally deploy an old
# pre-OpenAPI / pre-runner-fix image. Do not use :latest or short SHA tags.
# Example format: ghcr.io/flipflop121183/hermes-co@sha256:<64-hex-digest>
HERMES_ALPHA_IMAGE=

# Public hostname that resolves to this VM. A DNS A record is required for
# Let's Encrypt. A bare IP also works (Caddy internal CA, browser warning).
HERMES_ALPHA_DOMAIN=alpha.example.com
HERMES_ALPHA_ACME_EMAIL=ops@example.com

# Secrets. Generate each one separately; never reuse one for another.
HERMES_ALPHA_DB_PASSWORD=        # openssl rand -hex 24
HERMES_ALPHA_AUTH_SECRET=        # openssl rand -hex 32
HERMES_ALPHA_TOOL_SIGNING_SECRET=  # openssl rand -hex 32

# Set to true and `up -d` again once the first admin has accepted the
# bootstrap invite.
HERMES_ALPHA_DISABLE_SIGN_UP=false

# Optional provider keys for the alpha. Prefer Apps -> Connections in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=

# Optional overrides.
#HERMES_ALPHA_PROJECT=hermes-alpha
#HERMES_ALPHA_POSTGRES_IMAGE=postgres:17-alpine
#HERMES_ALPHA_CADDY_IMAGE=caddy:2-alpine
